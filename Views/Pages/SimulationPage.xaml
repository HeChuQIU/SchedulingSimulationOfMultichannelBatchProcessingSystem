<Page x:Class="SchedulingSimulationOfMultichannelBatchProcessingSystem.Views.Pages.SimulationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SchedulingSimulationOfMultichannelBatchProcessingSystem.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SimulationPage"
      d:DataContext="{d:DesignInstance local:SimulationPage,
                                 IsDesignTimeCreatable=False}"
      d:DesignHeight="800"
      d:DesignWidth="1250"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>

        <ResourceDictionary>
            <Style x:Key="DgStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="80" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1.3*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="1">
            <DockPanel LastChildFill="False">
                <ui:Button Content="运行" Foreground="Green" Margin="4,0"
                           Command="{Binding ViewModel.RunCommand,Mode=OneWay}"
                           IsEnabled="{Binding ViewModel.IsRunButtonEnabled,Mode=OneWay}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="停止" Foreground="Red" Margin="4,0"
                           Command="{Binding ViewModel.StopCommand,Mode=OneWay}"
                           IsEnabled="{Binding ViewModel.IsStopButtonEnabled,Mode=OneWay}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Stop24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="暂停" Margin="4,0"
                           Command="{Binding ViewModel.PauseCommand,Mode=OneWay}"
                           IsEnabled="{Binding ViewModel.IsPauseButtonEnabled,Mode=OneWay}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Pause24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="逐步" Margin="4,0"
                           Command="{Binding ViewModel.StepCommand,Mode=OneWay}"
                           IsEnabled="{Binding ViewModel.IsStepButtonEnabled,Mode=OneWay}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowStepInRight24" />
                    </ui:Button.Icon>
                </ui:Button>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1">
            <DockPanel>
                <Label Content="作业调度算法" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ViewModel.JobSchedulingAlgorithmNames}"
                          SelectedIndex="{Binding ViewModel.SelectedJobSchedulingAlgorithmIndex,Mode=TwoWay}"
                          Width="250" Margin="8,0">
                </ComboBox>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <DockPanel>
                <Label Content="进程调度算法" VerticalAlignment="Center" />
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ViewModel.ProcessSchedulingAlgorithmNames}"
                          SelectedIndex="{Binding ViewModel.SelectedProcessSchedulingAlgorithmIndex,Mode=TwoWay}"
                          Width="250" Margin="8,0">
                </ComboBox>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1">
            <DockPanel VerticalAlignment="Center">
                <Label Content="时间间隔：" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Slider TickPlacement="TopLeft" Width="200" Minimum="100" Maximum="1000"
                        TickFrequency="100" IsSnapToTickEnabled="True"
                        Value="{Binding ViewModel.Interval,Mode=TwoWay}" />
                <Label Content="{Binding ViewModel.Interval,Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>
        </Grid>

        <Grid x:Name="InfoGrid"
              Grid.Row="0" Grid.Column="2"
              Grid.RowSpan="2" Grid.ColumnSpan="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Label DockPanel.Dock="Top" HorizontalAlignment="Center" Content="当前时间" />
                <ui:TextBox Margin="4,-2,4,4"
                            IsReadOnly="{Binding ViewModel.IsCurrentTimeReadOnly}"
                            Text="{Binding ViewModel.CurrentTime,Mode=TwoWay}" />
            </DockPanel>
            <DockPanel Grid.Row="0" Grid.Column="1">
                <Label DockPanel.Dock="Top" HorizontalAlignment="Center" Content="平均周转时间" />
                <ui:TextBox Margin="4,-2,4,4" IsReadOnly="True"
                            Text="{Binding ViewModel.MeanTurnaroundTime,Mode=OneWay}" />
            </DockPanel>
            <DockPanel Grid.Row="1" Grid.Column="0">
                <Label DockPanel.Dock="Top" HorizontalAlignment="Center" Content="累计运行时间" />
                <ui:TextBox Margin="4,-2,4,4" IsReadOnly="True"
                            Text="{Binding ViewModel.ConsumedTime,Mode=OneWay}" />
            </DockPanel>
            <DockPanel Grid.Row="1" Grid.Column="1">
                <Label DockPanel.Dock="Top" HorizontalAlignment="Center" Content="平均带权周转时间" />
                <ui:TextBox Margin="4,-2,4,4" IsReadOnly="True"
                            Text="{Binding ViewModel.MeanWeightedTurnaroundTime,Mode=OneWay}" />
            </DockPanel>
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">内存占用图</Label>
                <ItemsControl ItemsSource="{Binding ViewModel.MemoryGridItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <DockPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color}"
                                    MinWidth="{Binding Width}">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">内存中正在执行的进程</Label>
                <ui:DataGrid ItemsSource="{Binding ViewModel.RunningJobs,Mode=OneWay}"
                             AutoGenerateColumns="False" HorizontalAlignment="Center"
                             AllowDrop="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="作业名称" Binding="{Binding JobName}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="到达时间" Binding="{Binding ArrivalTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="服务时间" Binding="{Binding ServiceTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="累计运行时间" Binding="{Binding RunningTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="剩余时间" Binding="{Binding RemainingServiceTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="内存需要" Binding="{Binding MemoryUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="磁带机需要" Binding="{Binding TapeUnitUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                    </DataGrid.Columns>
                </ui:DataGrid>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="4" Grid.Column="1" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">内存中就绪的进程队列</Label>
                <ui:DataGrid ItemsSource="{Binding ViewModel.ReadyJobs,Mode=OneWay}"
                             AutoGenerateColumns="False" HorizontalAlignment="Center"
                             AllowDrop="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="作业名称" Binding="{Binding JobName}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="到达时间" Binding="{Binding ArrivalTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="服务时间" Binding="{Binding ServiceTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="累计运行时间" Binding="{Binding RunningTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="剩余时间" Binding="{Binding RemainingServiceTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="内存需要" Binding="{Binding MemoryUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="磁带机需要" Binding="{Binding TapeUnitUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                    </DataGrid.Columns>
                </ui:DataGrid>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="4" Grid.Column="0" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">已提交的作业队列</Label>
                <ui:DataGrid ItemsSource="{Binding ViewModel.SubmittedJobs,Mode=OneWay}"
                             AutoGenerateColumns="False" HorizontalAlignment="Center"
                             AllowDrop="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="作业名称" Binding="{Binding JobName}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="到达时间" Binding="{Binding ArrivalTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="服务时间" Binding="{Binding ServiceTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="内存需要" Binding="{Binding MemoryUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="磁带机需要" Binding="{Binding TapeUnitUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                    </DataGrid.Columns>
                </ui:DataGrid>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="5" Grid.Column="1" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">已完成作业队列</Label>
                <ui:DataGrid ItemsSource="{Binding ViewModel.FinishedJobs,Mode=OneWay}"
                             AutoGenerateColumns="False" HorizontalAlignment="Center"
                             AllowDrop="False" CanUserAddRows="True" CanUserDeleteRows="True" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="作业名称" Binding="{Binding JobName}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="到达时间" Binding="{Binding ArrivalTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="服务时间" Binding="{Binding ServiceTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="完成时间" Binding="{Binding FinishTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="周转时间" Binding="{Binding TurnaroundTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="带权周转时间" Binding="{Binding WeightedTurnaroundTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="内存需要" Binding="{Binding MemoryUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="磁带机需要" Binding="{Binding TapeUnitUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                    </DataGrid.Columns>
                </ui:DataGrid>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="5" Grid.Column="0" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">未提交的作业队列</Label>
                <ui:DataGrid ItemsSource="{Binding ViewModel.UnSubmittedJobs,Mode=TwoWay}"
                             AutoGenerateColumns="False" HorizontalAlignment="Center"
                             AllowDrop="False" CanUserAddRows="True" CanUserDeleteRows="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="作业名称" Binding="{Binding JobName}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="到达时间" Binding="{Binding ArrivalTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="服务时间" Binding="{Binding ServiceTime}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="内存需要" Binding="{Binding MemoryUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                        <DataGridTextColumn Header="磁带机需要" Binding="{Binding TapeUnitUse}" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                    </DataGrid.Columns>
                </ui:DataGrid>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="4" Grid.Column="2"
              Grid.RowSpan="2" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">磁带机占用图</Label>
                <ui:DataGrid ItemsSource="{Binding ViewModel.TapeUnitGridItems,Mode=OneWay}"
                             AutoGenerateColumns="False" HorizontalAlignment="Center"
                             AllowDrop="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="磁带机情况" Binding="{Binding JobName }" Width="*"
                                            ElementStyle="{StaticResource DgStyle}" />
                    </DataGrid.Columns>
                </ui:DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</Page>