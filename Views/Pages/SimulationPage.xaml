<Page x:Class="SchedulingSimulationOfMultichannelBatchProcessingSystem.Views.Pages.SimulationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SchedulingSimulationOfMultichannelBatchProcessingSystem.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SimulationPage"
      d:DataContext="{d:DesignInstance local:SimulationPage,
                                 IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">内存占用图</Label>
                <ItemsControl ItemsSource="{Binding ViewModel.MemoryGridItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <DockPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color}"
                                    MinWidth="{Binding Width}">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">内存中正在执行的进程</Label>
                <ui:DataGrid />
            </DockPanel>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">内存中就绪的进程队列</Label>
                <ui:DataGrid />
            </DockPanel>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="0" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">已提交的作业队列</Label>
                <ui:DataGrid />
            </DockPanel>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="1" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">已完成作业队列</Label>
                <ui:DataGrid />
            </DockPanel>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="0" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">未提交的作业队列</Label>
                <ui:DataGrid />
            </DockPanel>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="2" Margin="8">
            <DockPanel>
                <Label DockPanel.Dock="Top">磁带机占用图</Label>
                <ui:DataGrid />
            </DockPanel>
        </Grid>
    </Grid>
</Page>